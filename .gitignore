# Dependencies
node_modules
.pnp
.pnp.js

# Build
.next
out
build
dist

# Galerie – tylko lokalnie (WEBP generowane przez npm run convert:linked)
public/galleries/**
!public/galleries/.gitkeep

# Credentials – nie commituj loginów/haseł do serwisów prasowych
content/press-credentials.json

# Surowe dane news (skan press roomów) — lokalnie / na serwerze CI
data/news/raw/**
data/news/images/**
data/news/ai-jobs/**
!data/news/.gitkeep
!data/news/index.json.example

# Import autoGALERIA — cache HTML/obrazów, nie do repo (patrz docs/CHANGESET-SPLIT-PLAN.md)
content/import/autogaleria/cache/**
content/import/autogaleria/images/**

# Env
.env
.env.local
.env.*.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# TS build cache
tsconfig.tsbuildinfo

# Lokalne narzędzia / artefakty tymczasowe
.claude/
.tmp-*
.tmp-import/

# Wideo — duże pliki binarne, serwowane lokalnie / przez CDN
public/videos/*.mp4
public/videos/*.webm
public/media/**/*.mp4
public/media/**/*.webm
# (poster JPG mogą trafić do repo jeśli są małe)
