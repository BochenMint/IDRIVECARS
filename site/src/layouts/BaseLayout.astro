---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteConfig, absoluteUrl } from '../lib/site';
import { organizationSchema, websiteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical,
  noIndex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = canonical ? absoluteUrl(canonical) : Astro.url.href.replace(Astro.url.origin, siteConfig.url);
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Consent Mode v2 — defaults MUST be denied before any ad/analytics tags load -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
    </script>
    <!-- TODO(CMP): Replace with certified CMP script after publisher approval.
         Cookiebot example:  id="Cookiebot" src="https://consent.cookiebot.com/uc.js"
           data-cbid="YOUR-COOKIEBOT-ID" data-blockingmode="auto"
         Complianz example:  plugin snippet with data-cmp-id="YOUR-COMPLIANZ-ID"
         Set CMP_PUBLISHER_ID in deploy env and wire the vendor callback to gtag('consent', 'update', …). -->
    <script is:inline>
      window.__cmpPublisherId = 'TODO_SET_CMP_PUBLISHER_ID';
      window.__cmpLoad = function () {
        if (window.__cmpPublisherId === 'TODO_SET_CMP_PUBLISHER_ID') {
          console.info('[CMP] Placeholder — podłącz Cookiebot/Complianz i ustaw CMP_PUBLISHER_ID.');
        }
      };
    </script>
    <JsonLd data={[organizationSchema(), websiteSchema(), ...extraJsonLd]} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Przejdź do treści</a>
    <Header />
    <div class="page-shell py-3">
      <AdSlot slot="leaderboard" label="Reklama — leaderboard 728×90" />
    </div>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
