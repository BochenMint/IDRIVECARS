---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';
import { breadcrumbSchema } from '../lib/seo';
---

<BaseLayout
  title="Kontakt"
  description="Skontaktuj się z redakcją IDRIVECARS"
  canonical="/kontakt"
  jsonLd={breadcrumbSchema([
    { name: 'Strona główna', path: '/' },
    { name: 'Kontakt', path: '/kontakt' },
  ])}
>
  <div class="page-shell py-12 md:py-16">
    <h1 class="font-display text-4xl text-[#171717] md:text-5xl">Kontakt</h1>
    <p class="mt-4 max-w-xl text-[#737373]">
      Pytania redakcyjne, współpraca i zgłoszenia błędów — napisz do nas.
    </p>
    <div class="mt-10 rounded-xl border border-stone-200 bg-white p-8">
      <p class="text-sm text-[#737373]">E-mail</p>
      <a href={`mailto:${siteConfig.email}`} class="font-display mt-1 block text-2xl text-[#b91c1c] hover:underline">
        {siteConfig.email}
      </a>
    </div>
  </div>
</BaseLayout>
