---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/seo';

const allModels = await getCollection('models');
const slugs = Astro.url.searchParams.getAll('m');
const selected =
  slugs.length > 0
    ? allModels.filter((m) => slugs.includes(m.data.slug)).slice(0, 3)
    : allModels.slice(0, 2);
---

<BaseLayout
  title="Porównanie modeli"
  description="Porównaj 2–3 modele samochodów — segment, ceny orientacyjne"
  canonical="/porownanie"
  jsonLd={breadcrumbSchema([
    { name: 'Strona główna', path: '/' },
    { name: 'Porównanie', path: '/porownanie' },
  ])}
>
  <section class="space-y-8">
    <header class="space-y-3">
      <p class="text-xs uppercase tracking-[0.25em] text-neutral-500">Porównanie</p>
      <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Porównanie modeli</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-neutral-600">
        Wybierz modele przez parametry URL: <code class="text-sm">?m=skoda-octavia&m=vw-golf</code>
      </p>
    </header>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[600px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-neutral-200">
            <th class="py-3 pr-4 font-medium text-neutral-500">Cecha</th>
            {selected.map((m) => (
              <th class="py-3 pr-4 font-display text-lg text-ink">
                <a href={`/modele/${m.data.slug}`} class="text-ink no-underline hover:opacity-80">
                  {m.data.brand} {m.data.model}
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="text-neutral-600">
          <tr class="border-b border-neutral-100">
            <td class="py-3 pr-4 font-medium">Segment</td>
            {selected.map((m) => <td class="py-3 pr-4">{m.data.segment}</td>)}
          </tr>
          <tr class="border-b border-neutral-100">
            <td class="py-3 pr-4 font-medium">Nadwozie</td>
            {selected.map((m) => <td class="py-3 pr-4">{m.data.bodyType ?? '—'}</td>)}
          </tr>
          <tr class="border-b border-neutral-100">
            <td class="py-3 pr-4 font-medium">Cena katalogowa</td>
            {selected.map((m) => (
              <td class="py-3 pr-4">
                {m.data.msrpPln
                  ? `ok. ${m.data.msrpPln.toLocaleString('pl-PL')} zł (orientacyjnie)`
                  : '—'}
              </td>
            ))}
          </tr>
          <tr class="border-b border-neutral-100">
            <td class="py-3 pr-4 font-medium">Rynek używanych</td>
            {selected.map((m) => (
              <td class="py-3 pr-4">
                {m.data.usedPriceEstPln
                  ? `ok. ${m.data.usedPriceEstPln.toLocaleString('pl-PL')} zł (orientacyjnie)`
                  : '—'}
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
