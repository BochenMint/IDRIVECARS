---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/seo';

const models = (await getCollection('models')).sort((a, b) =>
  a.data.brand.localeCompare(b.data.brand),
);
---

<BaseLayout
  title="Modele samochodów"
  description="Katalog modeli z orientacyjnymi cenami i kalkulatorem finansowania"
  canonical="/modele"
  jsonLd={breadcrumbSchema([
    { name: 'Strona główna', path: '/' },
    { name: 'Modele', path: '/modele' },
  ])}
>
  <section class="space-y-8">
    <header class="space-y-3">
      <p class="text-xs uppercase tracking-[0.25em] text-neutral-500">Modele</p>
      <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Modele</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-neutral-600">
        Orientacyjne ceny katalogowe i rynkowe używane.
      </p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        models.map((m) => (
          <a
            href={`/modele/${m.data.slug}`}
            class="rounded-xl border border-neutral-200/80 bg-white p-6 no-underline transition-shadow hover:shadow-md"
          >
            <p class="text-xs uppercase tracking-wide text-neutral-500">{m.data.segment}</p>
            <h2 class="font-display mt-1 text-xl text-ink">
              {m.data.brand} {m.data.model}
            </h2>
            {m.data.msrpPln && (
              <p class="mt-2 text-sm text-neutral-600">
                od ok. {m.data.msrpPln.toLocaleString('pl-PL')} zł (orientacyjnie)
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
