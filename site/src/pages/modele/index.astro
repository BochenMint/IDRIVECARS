---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/seo';

const models = (await getCollection('models')).sort((a, b) =>
  a.data.brand.localeCompare(b.data.brand),
);
---

<BaseLayout
  title="Modele samochodów"
  description="Katalog modeli z orientacyjnymi cenami i kalkulatorem finansowania"
  canonical="/modele"
  jsonLd={breadcrumbSchema([
    { name: 'Strona główna', path: '/' },
    { name: 'Modele', path: '/modele' },
  ])}
>
  <div class="page-shell py-12 md:py-16">
    <h1 class="font-display text-4xl text-[#171717] md:text-5xl">Modele</h1>
    <p class="mt-4 text-[#737373]">Orientacyjne ceny katalogowe i rynkowe używane.</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        models.map((m) => (
          <a
            href={`/modele/${m.data.slug}`}
            class="rounded-xl border border-stone-200 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <p class="text-xs uppercase tracking-wide text-[#737373]">{m.data.segment}</p>
            <h2 class="font-display mt-1 text-xl text-[#171717]">
              {m.data.brand} {m.data.model}
            </h2>
            {m.data.msrpPln && (
              <p class="mt-2 text-sm text-[#737373]">
                od ok. {m.data.msrpPln.toLocaleString('pl-PL')} zł (orientacyjnie)
              </p>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
