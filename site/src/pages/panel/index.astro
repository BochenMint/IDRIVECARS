---
import BaseLayout from '../../layouts/BaseLayout.astro';

const cmsUrl = import.meta.env.DEV
  ? 'http://127.0.0.1:8001/cms/'
  : 'http://127.0.0.1:8001/cms/';
---

<BaseLayout title="Panel CMS" description="Panel właściciela — publikacja treści" noIndex canonical="/panel">
  <div class="page-shell py-12 md:py-16">
    <h1 class="font-display text-3xl text-[#171717]">Panel właściciela</h1>
    <p class="mt-4 max-w-2xl text-[#737373]">
      Publikacja testów i newsów odbywa się przez CMS (FastAPI). W produkcji uruchamiasz go
      lokalnie na Macu w sieci LAN lub przez tunel z autoryzacją — <strong>nie wystawiaj publicznie</strong>
      bez hasła i VPN / Cloudflare Access.
    </p>
    <p class="mt-4 text-sm text-[#737373]">
      Uruchom lokalnie: <code>npm run cms</code> z katalogu głównego monorepo, następnie
      otwórz
      <a href={cmsUrl} class="text-ink hover:underline" target="_blank" rel="noopener noreferrer">
        {cmsUrl}
      </a>.
    </p>
    <p class="mt-4 text-sm text-[#737373]">
      Leadgen (leady, RODO): <code>npm run leadgen</code> →
      <a href="http://localhost:8000/dashboard" class="text-ink hover:underline">localhost:8000</a>.
    </p>
  </div>
</BaseLayout>
