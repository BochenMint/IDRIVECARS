---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestCard from '../components/TestCard.astro';
import { getCollection } from 'astro:content';
import { getFirstGalleryImageSrc } from '../lib/gallery';
import { siteConfig } from '../lib/site';

const allTests = (await getCollection('tests')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
);
const latestTests = allTests.slice(0, 6);

const heroFallbacks = latestTests.map((t) => getFirstGalleryImageSrc(t.data.galleryDir));
const heroIndex = heroFallbacks.findIndex(Boolean);
const heroImage =
  heroIndex >= 0
    ? heroFallbacks[heroIndex]
    : latestTests[0]?.data.heroImage
      ? `/${latestTests[0].data.heroImage.replace(/^\//, '')}`
      : null;
const heroTest = heroIndex >= 0 ? latestTests[heroIndex] : latestTests[0] ?? null;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="relative overflow-hidden rounded-2xl border border-neutral-200/80 bg-white">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr]">
      <div class="flex flex-col justify-center gap-6 p-8 sm:p-10 lg:p-14">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-muted">
          Portfolio dziennikarskie
        </p>
        <h1 class="font-display text-balance text-4xl leading-[1.1] tracking-tight sm:text-5xl lg:text-[3.25rem]">
          Testy samochodów bez krzyku. Z własnymi zdjęciami.
        </h1>
        <p class="max-w-lg text-base leading-relaxed text-neutral-600">
          IDRIVECARS to autorski blog motoryzacyjny Marcina Bochenka — spokojna typografia,
          duże fotografie i rzetelne pierwsze jazdy zamiast clickbaitu.
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a
            href="/testy"
            class="rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-white no-underline transition hover:bg-neutral-700"
          >
            Przeglądaj testy
          </a>
          <a
            href="/galerie"
            class="rounded-full border border-neutral-300 bg-white px-6 py-2.5 text-sm font-medium text-ink no-underline transition hover:border-neutral-400"
          >
            Galerie zdjęć
          </a>
        </div>
      </div>

      <div class="relative min-h-[280px] bg-neutral-100 lg:min-h-[420px]">
        {
          heroImage ? (
            <>
              <img
                src={heroImage}
                alt={
                  heroTest
                    ? `${heroTest.data.brand} ${heroTest.data.model} – zdjęcie z testu IDRIVECARS`
                    : 'Zdjęcie z testu samochodu IDRIVECARS'
                }
                class="absolute inset-0 h-full w-full object-cover"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent lg:bg-gradient-to-l lg:from-black/20" />
            </>
          ) : (
            <div class="flex h-full min-h-[280px] items-center justify-center text-sm text-muted">
              Galerie w trakcie importu
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="mt-12 grid gap-8 border-t border-neutral-200/80 pt-10 lg:grid-cols-3">
    <div class="space-y-2">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Testy</p>
      <p class="text-sm leading-relaxed text-neutral-600">
        Długie formy z danymi technicznymi, wrażeniami z jazdy i pełnymi galeriami — materiały
        pierwotnie publikowane na autoGaleria.pl.
      </p>
    </div>
    <div class="space-y-2">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Pierwsze jazdy</p>
      <p class="text-sm leading-relaxed text-neutral-600">
        Krótsze formy z eventów prasowych i premier — Focus RS, Passat, Fabia, Fiat 500 i
        dziesiątki innych modeli w archiwum.
      </p>
    </div>
    <div class="space-y-2">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Blog</p>
      <p class="text-sm leading-relaxed text-neutral-600">
        Wkrótce krótsze wpisy, obserwacje z rynku i materiały spoza testów długich. Na start —
        archiwum testów i galerie.
      </p>
    </div>
  </section>

  {
    latestTests.length > 0 && (
      <section class="mt-16 space-y-8">
        <div class="flex items-end justify-between gap-4 border-b border-neutral-200 pb-4">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Archiwum</p>
            <h2 class="mt-1 font-display text-3xl tracking-tight">Najnowsze testy</h2>
          </div>
          <a
            href="/testy"
            class="shrink-0 text-sm font-medium text-muted no-underline transition hover:text-ink"
          >
            Wszystkie →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latestTests.map((test, i) => (
            <TestCard test={test} heroImageFallback={heroFallbacks[i] ?? null} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
