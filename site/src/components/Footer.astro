---
import AdSlot from './AdSlot.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-white/80">
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <AdSlot slotId="footer" format="footer" class="mb-4" />
  </div>
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div>
      <p>© {year} IDRIVECARS / Marcin Bochenek</p>
      <p class="mt-1 text-neutral-400">
        Spokojny serwis o samochodach – testy, pierwsze jazdy i galerie zdjęć.
      </p>
    </div>
    <p class="text-neutral-400">
      <a href="/polityka-redakcyjna" class="text-neutral-500 no-underline hover:text-ink hover:underline">Polityka redakcyjna</a>
      {' · '}
      <a href="/modele" class="text-neutral-500 no-underline hover:text-ink hover:underline">Modele</a>
      {' · '}
      <a href="/porownanie" class="text-neutral-500 no-underline hover:text-ink hover:underline">Porównanie</a>
    </p>
  </div>
</footer>
