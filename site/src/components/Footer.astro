---
import { siteConfig } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-stone-200 bg-white">
  <div class="page-shell py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-display text-xl text-[#171717]">{siteConfig.name}</p>
        <p class="mt-2 text-sm text-[#737373]">{siteConfig.description}</p>
      </div>
      <div>
        <p class="text-sm font-semibold text-[#171717]">Nawigacja</p>
        <ul class="mt-3 space-y-2 text-sm text-[#737373]">
          <li><a href="/testy" class="hover:text-[#171717]">Testy</a></li>
          <li><a href="/news" class="hover:text-[#171717]">News</a></li>
          <li><a href="/polityka-redakcyjna" class="hover:text-[#171717]">Polityka redakcyjna</a></li>
          <li><a href="/kontakt" class="hover:text-[#171717]">Kontakt</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-[#171717]">Kontakt</p>
        <p class="mt-3 text-sm text-[#737373]">
          <a href={`mailto:${siteConfig.email}`} class="hover:text-[#171717]">{siteConfig.email}</a>
        </p>
      </div>
    </div>
    <p class="mt-10 text-center text-xs text-[#737373]">
      © {year} {siteConfig.author.name}. Wszelkie prawa zastrzeżone.
    </p>
  </div>
</footer>
