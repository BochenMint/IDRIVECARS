---
import { siteConfig } from '../lib/site';

const nav = [
  { href: '/testy', label: 'Testy' },
  { href: '/news', label: 'News' },
  { href: '/modele', label: 'Modele' },
  { href: '/porownanie', label: 'Porównanie' },
  { href: '/o-mnie', label: 'O mnie' },
];
---

<header class="animate-header sticky top-0 z-50 border-b border-stone-200/80 bg-[#fafaf8]/90 backdrop-blur-md">
  <div class="page-shell flex h-16 items-center justify-between">
    <a href="/" class="font-display text-2xl tracking-tight text-[#171717] hover:text-[#b91c1c]">
      {siteConfig.name}
    </a>
    <nav aria-label="Główne menu">
      <ul class="hidden items-center gap-6 md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-[#737373] transition-colors hover:text-[#171717]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href="/kontakt"
      class="rounded-full bg-[#171717] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[#b91c1c]"
    >
      Kontakt
    </a>
  </div>
</header>
