# Kanoniczny URL (SEO, OG, sitemap, sitemap-news, feed.xml)
NEXT_PUBLIC_SITE_URL=https://idrivecars.pl

# === PRODUKCJA (obowiązkowe) ===
# Hasło do panelu /admin/* i API /api/admin/* (Basic Auth: dowolny login + to hasło, lub Bearer token)
# BEZ tej zmiennej na produkcji panel i API są OTWARTE — krytyczne ryzyko bezpieczeństwa.
# Vercel/hosting: Settings → Environment Variables → Production + Preview
ADMIN_SECRET=

# === News AI (opcjonalne — lokalna redakcja, nie na Vercel serverless) ===
# Ollama (domyślnie):
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
LOCAL_AI_PROVIDER=ollama
# LM Studio / OpenAI-compatible:
# LOCAL_AI_BASE_URL=http://localhost:1234/v1
# LOCAL_AI_PROVIDER=openai

# Skan RSS (CI / cron — opcjonalne):
# NEWS_SOURCE_IDS=toyota-pressroom-rss

# === Reklamy (opcjonalne) ===
# Domyślnie sloty AdSlot są ukryte (brak podpiętej sieci reklamowej).
# Ustaw na "true" dopiero po integracji AdSense / programu partnerskiego (docs/PLAN-REKLAMY-I-NEWS.md).
NEXT_PUBLIC_ADS_ENABLED=false

# Google Analytics 4 (G-XXXXXXXXXX) — po zgodzie cookies
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tag (AW-XXXXXXXXX) — kampanie płatne
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google AdSense (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_BETWEEN_CARDS=
