# =============================================================================
# idrivecars.pl — zmienne produkcyjne (Mac Mini / self-hosted)
# =============================================================================
# Skopiuj na serwer:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Next.js ładuje .env.production automatycznie przy NODE_ENV=production.
# =============================================================================

# --- WYMAGANE ---

# Kanoniczny URL (SEO, OG, sitemap, feed, canonical)
NEXT_PUBLIC_SITE_URL=https://idrivecars.pl

# Hasło panelu /admin/* i Bearer dla /api/admin/*
# Generowanie (Mac/Linux):
#   openssl rand -base64 48
# PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
ADMIN_SECRET=

# Port aplikacji (domyślnie 3000; Caddy proxy → 127.0.0.1:3000)
PORT=3000

# --- ANALITYKA & REKLAMY (opcjonalne — włącz po założeniu kont Google) ---

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
# Utwórz w analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — tag konwersji (AW-XXXXXXXXX) — do pomiaru kampanii płatnych
# Utwórz w ads.google.com → Narzędzia → Konwersje → Tag globalny
NEXT_PUBLIC_GOOGLE_ADS_ID=

# AdSense — włącz sloty dopiero po akceptacji konta AdSense
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ID jednostek reklamowych AdSense (opcjonalne — mapowanie na sloty AdSlot)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_BETWEEN_CARDS=

# --- NEWS PIPELINE (cron na Mac Mini — opcjonalne) ---

# Ollama na tym samym Macu (Agentic OS Faza 1) lub zdalnie przez Tailscale
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
LOCAL_AI_PROVIDER=ollama

# Filtr źródeł RSS (domyślnie wszystkie włączone w sources.json)
# NEWS_SOURCE_IDS=toyota-pressroom-rss

# --- HOSTING (informacyjne — nie czytane przez Next.js) ---

# DEPLOY_PATH=/Users/marcin/sites/idrivecars
# NODE_ENV=production
