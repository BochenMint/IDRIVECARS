# CMS owner panel — copy to cms/.env and adjust
CMS_PASSWORD=changeme
CMS_SECRET=change-this-to-a-long-random-string
CMS_HOST=127.0.0.1
CMS_PORT=8001

# Optional: full deploy (build + rsync). Without it, publish runs npm build only.
# DEPLOY_PATH=/Users/you/Sites/idrivecars.pl

SITE_URL=https://idrivecars.pl
CMS_CONVERT_WEBP=true
CMS_MAX_UPLOAD_MB=15
CMS_DEPLOY_TIMEOUT=120
