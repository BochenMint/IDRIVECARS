# =============================================================================
# idrivecars.pl — szablon .env.production dla Mac Mini
# =============================================================================
# Na Macu:
#   cp deploy/mac-mini/.env.production.template .env.production
#   chmod 600 .env.production
#   nano .env.production   # wypełnij ADMIN_SECRET i opcjonalne ID Google
#
# NIE commituj .env.production — tylko ten template trafia do repo.
# =============================================================================

# --- WYMAGANE (bez tego deploy się wyłoży) ---

# Kanoniczny URL publiczny (SEO, OG, sitemap, feed)
NEXT_PUBLIC_SITE_URL=https://idrivecars.pl

# Hasło panelu /admin/* i Bearer dla /api/admin/*
# Wygeneruj na Macu:
#   openssl rand -base64 48
# Skopiuj wynik poniżej (bez cudzysłowów):
ADMIN_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# Port Next.js — Caddy proxy → 127.0.0.1:3000
PORT=3000

# --- ANALITYKA & REKLAMY (opcjonalne — włącz po założeniu kont Google) ---

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — tag konwersji (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# AdSense — dopiero po akceptacji konta
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Jednostki reklamowe AdSense (opcjonalne)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_BETWEEN_CARDS=

# --- NEWS PIPELINE (cron — opcjonalne) ---

# Ollama na tym samym Macu (Agentic OS) lub zdalnie przez Tailscale
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
LOCAL_AI_PROVIDER=ollama

# Filtr źródeł RSS (puste = wszystkie z sources.json)
# NEWS_SOURCE_IDS=toyota-pressroom-rss

# --- INFORMACYJNE (Next.js ich nie czyta) ---

# DEPLOY_PATH=/Users/TWOJ_USER/sites/idrivecars
# NODE_ENV=production
