{
  "name": "idrivecars",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix site",
    "build": "npm run build --prefix site",
    "test": "npm run test --prefix site",
    "test:finance": "npm run test --prefix site",
    "db:init": "python3 data/init_db.py",
    "agent": "python3 agent/pipeline.py",
    "leadgen": "uvicorn leadgen.main:app --reload --port 8000",
    "cms": "uvicorn cms.main:app --reload --host 127.0.0.1 --port 8001",
    "sync:content": "bash -c 'for f in content/testy/*.mdx; do cp -n \"$f\" \"site/src/content/tests/$(basename \"$f\" .mdx).md\"; done'",
    "deploy": "bash scripts/deploy-site.sh"
  }
}
